{
  "name": "awa-toolkit",
  "version": "2.5.0",
  "description": "Alienware Arena Toolkit — Artifact Optimizer, Control Center tasks, giveaway/vault filters, and UCF reading mode",
  "type": "module",
  "author": "jaredcat",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=26"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24"
    }
  },
  "scripts": {
    "lint": "eslint src --max-warnings 0 && tsc --noEmit",
    "lint:fix": "eslint src --fix --max-warnings 0 && tsc --noEmit",
    "test": "vitest run --exclude 'tests/sim/**'",
    "test:sim": "vitest run tests/sim/monthSim.test.ts",
    "dev": "vite",
    "build": "tsc && vite build"
  },
  "dependencies": {
    "@violentmonkey/dom": "^2.2.1",
    "@violentmonkey/ui": "^0.7.9"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jquery": "^4.0.1",
    "@types/node": "^26.6.6",
    "@violentmonkey/types": "^0.3.5",
    "eslint": "^10.15.0",
    "eslint-config-narwhal": "^2.1.16",
    "globals": "^17.14.0",
    "playwright-core": "^1.65.1",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vite-plugin-monkey": "^8.1.1",
    "vitest": "^5.1.1"
  },
  "packageManager": "pnpm@12.23.0"
}
