{
  "name": "awa-toolkit",
  "version": "2.0.0",
  "description": "Alienware Arena Toolkit — Artifact Optimizer, Control Center tasks, giveaway/vault filters, and UCF reading mode",
  "type": "module",
  "author": "jaredcat",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint src --max-warnings 0 && tsc --noEmit",
    "lint:fix": "eslint src --fix --max-warnings 0 && tsc --noEmit",
    "test": "vitest run --exclude 'tests/sim/**'",
    "test:sim": "vitest run tests/sim/monthSim.test.ts",
    "dev": "vite",
    "build": "tsc && vite build"
  },
  "dependencies": {
    "@violentmonkey/dom": "^2.2.1",
    "@violentmonkey/ui": "^0.7.9"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jquery": "^4.0.1",
    "@types/node": "^26.2.0",
    "@violentmonkey/types": "^0.3.4",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-unicorn": "^73.0.0",
    "globals": "^17.11.0",
    "playwright-core": "^1.62.1",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vite-plugin-monkey": "^8.1.0",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.22.0"
}
